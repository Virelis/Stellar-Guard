{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "browser": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "prefer-const": "error",
    "no-unused-vars": "off",
    "no-empty": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "target",
    "coverage",
    "*.wasm"
  ]
}
