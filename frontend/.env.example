# ──────────────────────────────────────────────
# Stellar-Guard — Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_* variables are exposed to the browser.
# ──────────────────────────────────────────────

# Base URL of the Stellar-Guard backend API.
# Development: http://localhost:4000
# Production:  https://stellar-guard-api.onrender.com (or your deployed API)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Stellar Network (TESTNET or MAINNET)
NEXT_PUBLIC_NETWORK=TESTNET

# Deployed Freeze Governance Contract ID on Stellar Testnet
NEXT_PUBLIC_CONTRACT_ID=CCM2U2RWZVKISBKOAUBCTSYA63GIYAVC4RRBZU4Q5KKY5ZOYN45LFYN4
