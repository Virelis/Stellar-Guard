# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.xdr text eol=lf

# PowerShell scripts on Windows
*.ps1 text

# Binary formats
*.wasm binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary

# Generated locks - collapse in GitHub diffs
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
