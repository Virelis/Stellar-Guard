#!/usr/bin/env node

const path = require("path");
const fs = require("fs");

const distEntry = path.resolve(__dirname, "..", "dist", "index.js");
const entry = fs.existsSync(distEntry) ? distEntry : path.resolve(__dirname, "..", "src", "index.js");

const cli = require(entry);
if (typeof cli.run === "function") {
  cli.run();
}
