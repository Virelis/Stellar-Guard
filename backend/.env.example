# ─────────────────────────────────────────────
# Stellar-Guard — Backend Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
# Port the Express server listens on.
# Required. Default: 4000
PORT=4000

# ── Stellar Network ───────────────────────────
# Horizon REST API base URL.
# Testnet:  https://horizon-testnet.stellar.org
# Mainnet:  https://horizon.stellar.org
# Required.
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for contract simulation and invocation.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-rpc.stellar.org  (or your own node)
# Required.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase — must match the network you deploy to.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
# Required.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Smart Contract ────────────────────────────
# Contract ID of the deployed FreezeGovernance Soroban contract.
# Deployed on Stellar Testnet:
FREEZE_CONTRACT_ID=CCM2U2RWZVKISBKOAUBCTSYA63GIYAVC4RRBZU4Q5KKY5ZOYN45LFYN4

# ── CORS ──────────────────────────────────────
# Origin(s) allowed to call this API.
# Development: http://localhost:3000
# Production:  https://stellar-guard.vercel.app
# Required.
ALLOWED_ORIGIN=https://stellar-guard.vercel.app

# ── Database ──────────────────────────────────
# Path to the SQLite audit-log database file.
# The file is created automatically on first run.
# Optional. Default: ./votes.db
DB_PATH=./votes.db
FCM_SERVER_KEY=
FCM_TOPIC=freeze_alerts

# ── Authentication & Security ─────────────────
# Secret used for signing JWT auth tokens. Must be >= 32 characters in production.
# Required in production.
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars-long

# Server Stellar secret key (starts with S) used to sign SEP-0010 WebAuth challenges.
# Required in production.
SERVER_SIGNING_KEY=SDN4D6H77KAZQ76S67VCEEQT6RFE3W7E4K2E2X3UG3J4KYYXUGZNYU6H

# Force strict authentication enforcement in development / non-production environments.
# (Always fail-closed and strictly enforced in production).
AUTH_REQUIRED=false

# Role-Based Access Control: Comma-separated list of Stellar public keys
# Whitelisted public keys receive their assigned role upon SEP-0010 authentication.
# Unlisted keys default to 'auditor' (read-only) role in production.
ADMIN_WALLETS=GBDEVIFVWB277NYUCGDUIWI2XNXOH4AC7WGBNHFQLIN5P5WZ74UHBSVV,GCKAZ62ZOOAOHYQ7L4F64YV5B7D7UGI4OWGFLQL3U6V7PYX2NY5R6ZHO
PROPOSER_WALLETS=GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN
